{
  "name": "discord-log-parser",
  "version": "1.0.0",
  "description": "Convert Discord chat exports into compact, LLM-optimized text. Single-file, client-side.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:accurate": "vite --mode accurate --port 5174",
    "build": "vite build",
    "build:accurate": "vite build --mode accurate && node scripts/rename-accurate.mjs",
    "build:all": "npm run build && npm run build:accurate",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.9.0",
    "vite": "^6.0.7",
    "vite-plugin-singlefile": "^2.1.0",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "css-select": "^7.0.0",
    "domutils": "^4.0.2",
    "gpt-tokenizer": "^3.4.0",
    "htmlparser2": "^12.0.0"
  }
}
